# Nx Witness 自動化測試環境變數配置範例
# 複製此文件為 .env 並填入實際值

# ================================================================
# VLM 自癒機制配置
# ================================================================

# 是否啟用 VLM 學習模式（true/false）
# 注意：啟用後會在測試失敗時調用 AI 視覺模型，會消耗 API Token
ENABLE_VLM_LEARNING=false

# VLM API Key（根據使用的提供商填入）
# Gemini API Key (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ================================================================
# Nx Cloud 登錄資訊
# ================================================================
NX_CLOUD_EMAIL=your_email@example.com
NX_CLOUD_PASSWORD=your_password_here

# ================================================================
# 測試配置
# ================================================================
# Chrome 調試端口
BROWSER_DEBUG_PORT=9222

# 測試報告輸出目錄
REPORT_OUTPUT_DIR=report

# 日誌級別 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
